  "source_review": {
    "official_code": "ValveSoftware source snapshots identify resources, parameters and state logic. The manifests do not call this pixel or retail-binary certification.",
    "community_previews": "hotglow, XSpark1 and smoke are explicitly identified as small community named-resource previews, not official Valve screenshots. Their converted PNG references keep the original small dimensions.",
    "vort_capture": "Asthalis Episode Two guide, printed page5, xref381, native320×240. Independently viewed the extracted image and the rendered full page. The hosting and exact retail binary/settings are qualified rather than treated as official Valve publication.",
    "vort_reference_sha256": "5e78886d4deef3f149ab0491bc46e0405f8fc4f88493bcb08ac663c4c5c48f43"
  },
  "independent_visual_observations": [
    {
      "subject": "houndeye_pack4_v1_vs_v2",
      "finding": "The v1 has a strong colored veil between the rings. The v2 shows clear negative space between the two concentric rings and at the center on light and dark backgrounds. Band width, inner/outer proportions and halo changed; this supports preferring v2 for review, not a geometric or palette certification.",
      "severity": "documented_candidate_limit",
      "agrees_with_manifest": true
    },
    {
      "subject": "gauss_charged_v1_vs_v2",
      "finding": "The first charged beam appears much thicker than the intended restrained segment. The v2 is visibly thinner, horizontal and transparent around the beam. The recorded PNG width comparison is not conflated with the engine beam-width parameter. No exact2.5 visual-ratio claim is justified.",
      "severity": "documented_candidate_limit",
      "agrees_with_manifest": true
    },
    {
      "subject": "gauss_impact_hotglow",
      "finding": "Compact warm contact flare only. The enlarged radial rays are interpreted from a tiny community preview; other impact particles are absent. Metadata correctly leaves the full impact state incomplete.",
      "severity": "documented_candidate_limit",
      "agrees_with_manifest": true
    },
    {
      "subject": "gluon_tip_and_fade",
      "finding": "Both show a contact flare without a residual long beam. The fade is an enlarged blue/cyan sample, not an animation. Its silhouette and intensity are not an exact time sample from retail. FIRE_WIDE scope and renderamt-versus-PNG-alpha distinction are preserved.",
      "severity": "documented_candidate_limit",
      "agrees_with_manifest": true
    },
    {
      "subject": "vortigaunt_offensive_beam_attribution",
      "finding": "In Asthalis image, the right-hand Vortigaunt faces left and emits white/pale-green filaments toward the bright yellow-green flash above the table. The left-hand Vortigaunt is tending Alyx. The generated isolated oblique segment follows the right-hand emission and excludes the healer, people, scenery, hand aura and terminal yellow flash. Its high-resolution geometry is reconstructed.",
      "severity": "scope_confirmed_candidate_not_certified",
      "agrees_with_manifest": true
    }
  ],
  "remaining_limits": [
